POSTGRES_DB=signal_ledger
POSTGRES_USER=signal_ledger
POSTGRES_PASSWORD=change-this-before-use
DATABASE_URL=postgresql+psycopg://signal_ledger:change-this-before-use@db:5432/signal_ledger
REDIS_URL=redis://redis:6379/0
APP_SECRET=replace-with-a-long-random-secret
HMAC_SECRET=replace-with-a-separate-long-random-secret
RAW_RETENTION_DAYS=30
NORMALIZED_RETENTION_DAYS=365
SESSION_DAYS=7
COOKIE_SECURE=false
RATE_LIMIT_PER_MINUTE=120
CARTO_API_KEY=
ADDRESS_ENCRYPTION_KEY=
RAW_STORAGE_ENCRYPTION_KEY=
UPLOAD_SCANNER_COMMAND=
UPLOAD_SCANNER_REQUIRED=false
UPLOAD_SCANNER_TIMEOUT_SECONDS=120
PARSER_ISOLATION_MODE=off
PARSER_ISOLATION_TIMEOUT_SECONDS=120
PARSER_MAX_MEMORY_MB=512
PARSER_MAX_CPU_SECONDS=90
